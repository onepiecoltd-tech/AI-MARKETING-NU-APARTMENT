# Copy file này thành .env khi chạy LOCAL để test (không commit file .env thật).
# Khi deploy qua GitHub Actions, toàn bộ các biến này phải được cấu hình tại:
# GitHub Repo -> Settings -> Secrets and variables -> Actions

# ---- Google Workspace ----
# Nội dung JSON của Service Account (có quyền Drive + Sheets), hoặc đường dẫn file JSON local.
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GSHEET_ID=

# ---- LLM ----
LLM_PROVIDER=openai          # openai | gemini
LLM_API_KEY=
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_GEMINI=gemini-1.5-pro

# ---- Meta Ads ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_xxx
META_PAGE_ID=
META_API_VERSION=v21.0

# ---- TikTok Ads ----
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_IDENTITY_ID=
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# ---- Google Ads ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
YOUTUBE_REFRESH_TOKEN=        # dùng cho Google Ads (upload Unlisted) — xem thêm mục Organic bên dưới

# ======================================================================
# ĐĂNG ORGANIC (không qua Ads) — jobs/run_organic_post.py
# Chỉ cần điền nhóm nào anh thực sự dùng trong Content_Queue.Platforms
# ======================================================================

# ---- YouTube organic (dùng lại GOOGLE_ADS_CLIENT_ID/SECRET ở trên) ----
# YOUTUBE_REFRESH_TOKEN ở trên cũng được dùng lại cho đăng organic.

# ---- Facebook Page organic ----
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=          # Page Access Token, quyền pages_manage_posts — KHÁC META_ACCESS_TOKEN (Ads)

# ---- Instagram organic ----
IG_BUSINESS_ACCOUNT_ID=        # Instagram Business/Creator Account ID, liên kết với FB Page trên
# Instagram dùng lại FB_PAGE_ACCESS_TOKEN — không cần thêm token riêng.
# LƯU Ý: Media_Drive_URL trong Content_Queue PHẢI share "Anyone with the link"
# (không chỉ share cho Service Account) vì Instagram tự fetch qua URL công khai.

# ---- TikTok organic (Content Posting API — app RIÊNG, khác TikTok Ads) ----
TIKTOK_CONTENT_ACCESS_TOKEN=   # access token scope video.publish, từ app "Login Kit + Content Posting API"
TIKTOK_CONTENT_API_BASE=https://open.tiktokapis.com/v2

# ---- Notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Pipeline tuning (tùy chọn, có default) ----
MEDIA_CACHE_DIR=/tmp/media_cache
MAX_MEDIA_FILE_MB=500
REPORT_LOOKBACK_DAYS=7
MAX_RETRIES=5
RETRY_BASE_DELAY_SEC=2
